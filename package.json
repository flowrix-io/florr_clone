{
  "name": "florrclone",
  "version": "0.5.0",
  "main": "index.js",
  "scripts": {
    "build:map": "node scripts/encodeMap.js",
    "build": "node scripts/encodeMap.js && webpack --mode production && cp src/styles.css dist/styles.css && cp src/favicon.ico dist/favicon.ico && cp src/land.svg dist/land.svg && cp src/index.html dist/index.html && node scripts/compressbundle.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "npm run build:server && node --max-old-space-size=192 --optimize-for-size dist/server.js",
    "dev": "webpack --mode development --watch",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start_nobuild": "node --max-old-space-size=192 --optimize-for-size dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.9.3",
    "ts-loader": "^9.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
